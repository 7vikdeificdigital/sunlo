{
  "expo": {
    "name": "Sunlo Partner",
    "slug": "sunlo-partner",
    "scheme": "sunlopartner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.satvik.sunlo.partner",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Call par baat karne ke liye microphone chahiye.",
        "NSCameraUsageDescription": "Video call ke liye camera chahiye.",
        "UIBackgroundModes": [
          "audio"
        ],
        "NSPhotoLibraryUsageDescription": "Profile photo aur ID document chunne ke liye."
      },
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.satvik.sunlo.partner",
      "adaptiveIcon": {
        "backgroundColor": "#E3F4F1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": false
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#F5FAF9"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Profile photo aur ID document chunne ke liye."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://sunlo-zfqd.onrender.com/api/v1"
    }
  }
}
