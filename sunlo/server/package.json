{
  "name": "sunlo-server",
  "version": "1.0.0",
  "private": true,
  "description": "Sunlo backend (Node.js + TypeScript + PostgreSQL)",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:import-uploads": "tsx scripts/import-uploads.ts"
  },
  "dependencies": {
    "agora-token": "2.0.5",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "drizzle-orm": "^0.44.7",
    "express": "5.1.0",
    "express-rate-limit": "7.5.0",
    "firebase-admin": "13.4.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "pg": "^8.16.3",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "razorpay": "2.9.6",
    "socket.io": "4.8.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "5.0.1",
    "@types/jsonwebtoken": "9.0.9",
    "@types/node": "22.13.10",
    "@types/pg": "^8.15.5",
    "@types/supertest": "6.0.2",
    "drizzle-kit": "^0.31.5",
    "socket.io-client": "4.8.1",
    "supertest": "7.1.0",
    "tsx": "4.19.3",
    "typescript": "5.8.2",
    "vitest": "3.0.9"
  }
}
