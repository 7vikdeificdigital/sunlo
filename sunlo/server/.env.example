# Bondty server ki settings. Is file ko .env naam se copy karein aur asli values bharein.
# .env kabhi git/zip mein na daalein.

NODE_ENV=development            # production server par: production
PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/bondty

# Server kisi proxy / load balancer ke peeche hai (Render, Railway, Nginx, Cloudflare)? To true.
# Bina iske sab users ek hi IP dikhte hain aur 300 requests/minute ki seema sab par milkar lagti hai.
TRUST_PROXY=false
CORS_ORIGINS=https://admin.bondty.com   # admin panel ka domain (comma se kai)

# Har ek ke liye naya random secret: openssl rand -hex 32
JWT_ACCESS_SECRET=
OTP_PEPPER=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Login: firebase (DLT ki zaroorat nahi) ya otp (MSG91 + DLT)
AUTH_MODE=otp
# Sirf development: test number aur OTP, jaise +919999999999:123456 (production mein chalta hi nahi)
TEST_LOGINS=
SMS_PROVIDER=console            # production: msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Payment
PAYMENT_PROVIDER=mock           # production: razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Play Store build mein coins Google Play Billing se bikte hain
GOOGLE_PLAY_PACKAGE_NAME=com.bondty.app
GOOGLE_PLAY_SERVICE_ACCOUNT_BASE64=

# Voice/video call (production mein zaroori)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Vendor ke bank/PAN encrypt karne ki key: openssl rand -base64 32 (backup zaroor rakhein, khoi to data nahi khulega)
PAYOUT_ENC_KEY=

UPLOAD_DIR=./uploads
# Optional: profile photos Cloudinary CDN par
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gifting: true (ya khaali) = chalu, false = saare gifts pause (app mein gift button bhi chhup jata hai)
GIFTING_ENABLED=true
